# ── Firebase web configuration (public values, safe in the client bundle) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Realtime Database — note the "-default-rtdb" host
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://<project>-default-rtdb.firebaseio.com

# Root node used by this store inside the database
NEXT_PUBLIC_FIREBASE_DB_ROOT=rudraksh

# Email allowed to bootstrap the first admin account at /admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@rudrakshcollection.in

# Canonical site URL used by metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://rudrakshcollection.in

# ── Server-only ────────────────────────────────────────────────────────────
# Razorpay keys (Dashboard → Settings → API keys). Online payment stays hidden
# at checkout until both are set AND FIREBASE_SERVICE_ACCOUNT is configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase service-account JSON, as a single-line string (server only, never
# NEXT_PUBLIC_*). Enables server-validated order writing in /api/checkout.
# Optional: without it checkout still works and the browser writes the order.
# Generate: Firebase Console → Project settings → Service accounts → new key.
FIREBASE_SERVICE_ACCOUNT=
