# ── Firebase web configuration ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
FIREBASE_PROJECT_ID=<project>
FIREBASE_STORAGE_BUCKET=<project>.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=https://<project>-default-rtdb.firebaseio.com
FIREBASE_DB_ROOT=rudraksh

# Email allowed to bootstrap the first admin account at /admin
ADMIN_EMAIL=

# Canonical site URL used by metadata, sitemap and robots
SITE_URL=

# Extra hosts the image optimizer may fetch from, comma-separated (optional).
# images.unsplash.com, Google profile photos and Firebase Storage are built in.
IMAGE_HOSTS=

# ── Server-only ────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type into Razorpay Dashboard → Settings → Webhooks when adding
#   https://<your-domain>/api/razorpay/webhook
# (events: payment.captured, payment.authorized, order.paid). With it set, a
# paid order is recorded even if the customer closes the tab right after paying.
RAZORPAY_WEBHOOK_SECRET=

# Firebase service-account JSON, as a string or base64
FIREBASE_SERVICE_ACCOUNT=

# ── Transactional email over SMTP (server only) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Rudraksh Collection
