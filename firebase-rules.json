{
  "rules": {
    ".read": false,
    ".write": false,
    "rudraksh": {
      "products": {
        ".read": true,
        ".write": "auth != null",
        ".indexOn": [
          "slug",
          "category_slug",
          "brand_slug",
          "is_featured"
        ]
      },
      "brands": {
        ".read": true,
        ".write": "auth != null"
      },
      "categories": {
        ".read": true,
        ".write": "auth != null"
      },
      "settings": {
        ".read": true,
        ".write": "auth != null"
      },
      "banners": {
        ".read": true,
        ".write": "auth != null"
      },
      "coupons": {
        ".read": true,
        ".write": "auth != null",
        ".indexOn": [
          "code"
        ]
      },
      "couponRedemptions": {
        ".read": true,
        ".write": "auth != null"
      },
      "couponRedemptionsByPhone": {
        ".read": true,
        ".write": "auth != null"
      },
      "userCoupons": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "admins": {
        ".read": "auth != null",
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "adminRequests": {
        ".read": "auth != null",
        ".indexOn": [
          "requested_at"
        ],
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "orders": {
        ".read": "auth != null",
        ".indexOn": [
          "order_number",
          "user_id",
          "order_status"
        ],
        "$orderId": {
          ".read": true,
          ".write": true
        }
      },
      "ordersByUser": {
        "$uid": {
          ".read": true,
          "$orderId": {
            ".write": true
          }
        }
      },
      "activity": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "tracking": {
        ".read": true,
        ".indexOn": [
          "order_number"
        ],
        "$orderNumber": {
          ".read": true,
          ".write": true
        }
      },
      "messages": {
        ".read": "auth != null",
        ".indexOn": [
          "status",
          "created_at"
        ],
        "$messageId": {
          ".write": true
        }
      }
    }
  }
}
